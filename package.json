{
	"name": "iitmconnect",
	"version": "1.0.0",
	"description": "IITMConnect — Unified Campus Platform for IIT Madras",
	"private": true,
	"workspaces": [
		"client",
		"server"
	],
	"scripts": {
		"dev:server": "npm run dev -w server",
		"dev:client": "npm run dev -w client",
		"dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
		"build": "npm run build --workspaces --if-present",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"clean": "npm run clean --workspaces --if-present && rimraf node_modules",
		"reinstall": "rimraf node_modules package-lock.json && npm install"
	},
	"author": "Siva Peddinti",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/peddintisonu/IITM-Connect.git"
	},
	"bugs": {
		"url": "https://github.com/peddintisonu/IITM-Connect/issues"
	},
	"homepage": "https://github.com/peddintisonu/IITM-Connect#readme",
	"devDependencies": {
		"@typescript-eslint/eslint-plugin": "^8.58.1",
		"@typescript-eslint/parser": "^8.58.1",
		"concurrently": "^9.2.1",
		"eslint": "^9.x",
		"eslint-config-prettier": "^10.x",
		"eslint-plugin-prettier": "^5.x",
		"globals": "^17.4.0",
		"prettier": "^3.x",
		"rimraf": "^6.1.3",
		"typescript": "^6.x"
	}
}
